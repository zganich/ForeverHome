# NOT APPLIED. Every placeholder and resource requires separate approval.
# Public invoker IAM is NOT included; approve it explicitly for browser/Stripe.
apiVersion: serving.knative.dev/v1
kind: Service
metadata:
  name: REPLACE_APPROVED_API_SERVICE
  annotations:
    run.googleapis.com/ingress: all
spec:
  template:
    metadata:
      annotations:
        autoscaling.knative.dev/minScale: '0'
        autoscaling.knative.dev/maxScale: '2'
        run.googleapis.com/cloudsql-instances: REPLACE_PROJECT:us-central1:REPLACE_INSTANCE
        run.googleapis.com/startup-cpu-boost: 'false'
    spec:
      serviceAccountName: REPLACE_RUNTIME_SA@REPLACE_PROJECT.iam.gserviceaccount.com
      containerConcurrency: 4
      timeoutSeconds: 300
      containers:
        - image: us-central1-docker.pkg.dev/REPLACE_PROJECT/REPLACE_REPOSITORY/api@sha256:REPLACE_DIGEST
          ports:
            - containerPort: 8080
          resources:
            limits:
              cpu: '1'
              memory: 512Mi
          env:
            - name: GOOGLE_CLOUD_PROJECT
              value: REPLACE_PROJECT
            - name: CLOUD_SQL_CONNECTION_NAME
              value: REPLACE_PROJECT:us-central1:REPLACE_INSTANCE
            - name: GCS_BUCKET
              value: REPLACE_PUBLIC_MEDIA_BUCKET
            - name: APP_URL
              value: https://interpwhat.com
            - name: CORS_ALLOWED_ORIGINS
              value: https://REPLACE_PROJECT.web.app
            - name: OPENAI_MODEL
              value: gpt-4.1-mini
            - name: OPENAI_BASE_URL
              value: https://api.openai.com/v1
            - name: OWNER_OPEN_ID
              value: REPLACE_VERIFIED_FIREBASE_OWNER_UID
            - name: DATABASE_URL
              valueFrom:
                secretKeyRef: { name: foreverhome-database-url, key: REPLACE_PINNED_VERSION }
            - name: OPENAI_API_KEY
              valueFrom:
                secretKeyRef: { name: foreverhome-openai-api-key, key: REPLACE_PINNED_VERSION }
            - name: STRIPE_SECRET_KEY
              valueFrom:
                secretKeyRef: { name: foreverhome-stripe-test-secret-key, key: REPLACE_PINNED_VERSION }
            - name: STRIPE_WEBHOOK_SECRET
              valueFrom:
                secretKeyRef: { name: foreverhome-stripe-test-webhook-secret, key: REPLACE_PINNED_VERSION }
          startupProbe:
            httpGet: { path: /healthz, port: 8080 }
            periodSeconds: 5
            failureThreshold: 24
          livenessProbe:
            httpGet: { path: /healthz, port: 8080 }
            periodSeconds: 30
