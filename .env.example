# Existing InterpWhat UI is preserved; this session restores its runtime.
# Copy to .env locally. Never commit real credentials.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://user:password@localhost:5432/interpwhat

# Browser authentication (public anon or publishable key, never service_role).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-key
# Server falls back to the VITE_ values above. These aliases are optional.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-public-key

# Direct AI provider. Base URL includes /v1 exactly once.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# Existing app title; rebrand is deferred.
VITE_APP_TITLE=InterpWhat
VITE_APP_LOGO=
# Public app origin for payment redirects. Required for deployed checkout.
APP_URL=http://localhost:3000
# Optional existing analytics settings; omit both to disable.
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# Supabase user UUID for the owner account; never browser-supplied metadata.
OWNER_OPEN_ID=

# Authenticated image uploads require a provisioned Vercel Blob store/token.
# Image formats: JPEG, PNG, GIF, WebP. Maximum upload size: 4 MB.
BLOB_READ_WRITE_TOKEN=

# Keep test mode during revival. Stripe account configuration is a live gate.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Configure Stripe's webhook endpoint as /api/stripe/webhook and subscribe to:
# checkout.session.completed, checkout.session.async_payment_succeeded,
# invoice.paid, customer.subscription.updated, customer.subscription.deleted.

# Optional direct owner notification webhook. Disabled when omitted.
# Provisioning and external sends require live authorization.
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_TOKEN=

# Manus/Forge variables and JWT_SECRET are no longer used by the app.
