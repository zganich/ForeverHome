# InterpWhat Environment Variables
# Copy this file to .env and fill in your values
# Never commit .env file to version control

# ============================================
# Server Configuration
# ============================================
NODE_ENV=development
PORT=3000

# ============================================
# Application ID (Manus Platform)
# ============================================
# Get from Manus platform dashboard
VITE_APP_ID=your-app-id-here

# ============================================
# Database (PostgreSQL)
# ============================================
# Format: postgresql://user:password@host:port/database
# Example: postgresql://postgres:password@localhost:5432/interpwhat
# Or use Railway/other provider connection string
DATABASE_URL=postgresql://user:password@host:port/database

# ============================================
# Supabase (Client-Side Authentication)
# ============================================
# Get these from Supabase Dashboard → Settings → API
# Project URL: https://xxxxx.supabase.co
# Anon Key: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ============================================
# OAuth (Manus Platform)
# ============================================
# OAuth server URL for authentication
OAUTH_SERVER_URL=https://oauth-server-url
OAUTH_CLIENT_ID=your-oauth-client-id
OAUTH_CLIENT_SECRET=your-oauth-client-secret
OWNER_OPEN_ID=your-owner-open-id

# ============================================
# JWT Secret
# ============================================
# Generate a secure random string for JWT token signing
# You can generate one with: openssl rand -base64 32
JWT_SECRET=your-secure-jwt-secret-here

# ============================================
# OpenAI API
# ============================================
# Get API key from https://platform.openai.com/api-keys
# Used for GPT-4 Vision (behavior analysis) and TTS (voice)
OPENAI_API_KEY=sk-your-openai-api-key-here

# ============================================
# Storage (Forge API - Manus Platform)
# ============================================
# Built-in storage API for file uploads
BUILT_IN_FORGE_API_URL=https://forge-api-url
BUILT_IN_FORGE_API_KEY=your-forge-api-key

# ============================================
# Stripe (Payments - Optional)
# ============================================
# Get from https://dashboard.stripe.com/apikeys
# Test keys start with sk_test_ and pk_test_
# Production keys start with sk_live_ and pk_live_
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key

# ============================================
# AWS S3 (Alternative Storage - If Not Using Forge API)
# ============================================
# Optional: Only if you want to use AWS S3 instead of Forge API
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=interpwhat-uploads

# ============================================
# Email Service (Optional)
# ============================================
# For transactional emails (Resend recommended)
# RESEND_API_KEY=re_your-resend-api-key

# ============================================
# Notes
# ============================================
# - Frontend variables must be prefixed with VITE_ to be accessible in client code
# - Never commit this file with real values
# - Keep .env in .gitignore (already configured)
# - For production, set variables in Railway/Supabase dashboards, not in .env file
