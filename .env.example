# InterpWhat Environment Variables
# Copy this file to .env and fill in your actual values

# ============================================================================
# REQUIRED - Server Configuration
# ============================================================================

# Node Environment (production, development)
NODE_ENV=development

# PostgreSQL Database Connection String
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://user:password@localhost:5432/interpwhat

# JWT Secret for session cookie signing
# Generate a secure random string (e.g., openssl rand -hex 32)
JWT_SECRET=your-secure-jwt-secret-here

# ============================================================================
# REQUIRED - Application Configuration
# ============================================================================

# App ID (from Manus platform or your app identifier)
VITE_APP_ID=your-app-id-here

# App Title (displayed in UI)
VITE_APP_TITLE=InterpWhat

# App Logo URL (optional, can be a data URL or external URL)
VITE_APP_LOGO=

# ============================================================================
# REQUIRED - Supabase (Client-Side Authentication)
# ============================================================================

# Supabase Project URL
# Get this from: https://supabase.com → Your Project → Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase Anonymous Key (public key, safe for client-side)
# Get this from: https://supabase.com → Your Project → Settings → API
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ============================================================================
# REQUIRED - OpenAI (AI Analysis)
# ============================================================================

# OpenAI API Key
# Get this from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# ============================================================================
# REQUIRED - OAuth (Manus Platform)
# ============================================================================

# OAuth Server URL
OAUTH_SERVER_URL=https://your-oauth-server-url.com

# OAuth Client ID
OAUTH_CLIENT_ID=your-oauth-client-id

# OAuth Client Secret
OAUTH_CLIENT_SECRET=your-oauth-client-secret

# ============================================================================
# OPTIONAL - OAuth & Admin
# ============================================================================

# Owner Open ID (for admin/owner checks - optional)
OWNER_OPEN_ID=

# ============================================================================
# OPTIONAL - Forge API (Data API, Notifications, LLM Fallback)
# ============================================================================
# Note: File storage now uses Vercel Blob (automatic, no keys needed)
# These are only needed if using Forge API for dataApi, notifications, or LLM fallback

BUILT_IN_FORGE_API_URL=https://your-forge-api-url.com
BUILT_IN_FORGE_API_KEY=your-forge-api-key

# ============================================================================
# OPTIONAL - Stripe (Payments)
# ============================================================================
# Only needed if implementing payment features

STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key

# ============================================================================
# OPTIONAL - Vercel Blob Storage (Automatic in Production)
# ============================================================================
# These are automatically set in Vercel production environment
# For local development, you may need to set:
# VERCEL_BLOB_STORE_ID=your-blob-store-id (if using Vercel Blob locally)

# ============================================================================
# NOTES
# ============================================================================
# - Variables prefixed with VITE_ are exposed to the client-side code
# - Variables without VITE_ are server-only and secure
# - Never commit your .env file to version control
# - For production deployment, set these in your hosting platform's environment variables
