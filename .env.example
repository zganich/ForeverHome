# Existing InterpWhat UI is preserved; rebrand is deferred.
# Placeholders only. Real hosted secrets belong in Secret Manager, never files.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://user:password@localhost:5432/interpwhat

# PUBLIC browser build configuration. Firebase API key is not an admin secret.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=
# Empty for same-origin local development; exact Cloud Run HTTPS origin hosted.
VITE_API_BASE_URL=

# Runtime uses ADC via the attached service account, not a JSON private key.
GOOGLE_CLOUD_PROJECT=your-project
GCS_BUCKET=your-private-media-bucket
# Hosted Cloud Run socket attachment; omit for local Postgres TCP.
CLOUD_SQL_CONNECTION_NAME=
# Additional exact browser origins, comma separated. APP_URL is always allowed.
CORS_ALLOWED_ORIGINS=

# Direct AI provider. Base URL includes /v1 exactly once.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# Existing app title; rebrand is deferred.
VITE_APP_TITLE=InterpWhat
VITE_APP_LOGO=
# Public app origin for payment redirects. Required for deployed checkout.
APP_URL=http://localhost:3000
# Optional existing analytics settings; omit both to disable.
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# Verified Firebase UID for the owner account; never browser-supplied metadata.
OWNER_OPEN_ID=

# Image uploads: authenticated GCS writes and authenticated API reads.
# Keep bucket private; public-read IAM is not required.
# JPEG, PNG, GIF, WebP, maximum 4 MB. No storage API key/token is required.

# Keep test mode during revival. Stripe account configuration is a live gate.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Configure Stripe's webhook endpoint as /api/stripe/webhook and subscribe to:
# checkout.session.completed, checkout.session.async_payment_succeeded,
# invoice.paid, customer.subscription.updated, customer.subscription.deleted.

# Optional direct owner notification webhook. Disabled when omitted.
# Provisioning and external sends require live authorization.
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_TOKEN=

# Supabase, Vercel Blob, Manus/Forge and JWT_SECRET are no longer used.

# DB-backed AI admission. Defaults are hard maxima; overrides may only lower.
# true (or malformed flag) denies all AI work, including quality cache hits.
AI_DISABLED=false
AI_USER_IN_FLIGHT=1
AI_USER_DAILY_ANALYSES=10
AI_USER_DAILY_HELPERS=10
AI_USER_DAILY_PROVIDER_CALLS=50
AI_PROJECT_DAILY_PROVIDER_CALLS=100
# Helpers use a separate daily allowance and require a positive credit balance.
# Apply migration 0005 before any separately approved release; missing tables deny.
